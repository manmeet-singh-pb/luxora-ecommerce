# Copy this file to .env and fill in real values for your machine.
# .env is gitignored — never commit actual secrets.

DATABASE_PATH=luxora.db

# Required for session security (authentication). Generate a random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random key is used and sessions won't survive restarts.
SECRET_KEY=change-me-to-something-random

FLASK_DEBUG=0
PORT=5001
